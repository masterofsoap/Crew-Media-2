// Cloudflare Pages config (crew-media-2.pages.dev). Serves the built SPA and forwards /api/* to
// the crew-plus Worker over a service binding. The Worker itself is configured in
// wrangler.worker.jsonc (D1, R2, Queues, Durable Objects, Cron, AI).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crew-media-2",
  "pages_build_output_dir": "./dist/client",
  "compatibility_date": "2026-10-01",
  "services": [{ "binding": "API", "service": "crew-plus" }]
}
